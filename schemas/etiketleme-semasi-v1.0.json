{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gold Değerlendirme Seti — Etiketleme Şeması v1.0",
  "type": "object",
  "required": [
    "sample_id",
    "sample_rate",
    "channel",
    "speaker",
    "turn_index",
    "is_silence_probe",
    "transcript_raw",
    "transcript_normalized",
    "expected_entities",
    "normalization_ruleset_version",
    "pii_redacted",
    "annotator_1_id",
    "annotator_2_id"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "description": "Benzersiz kayıt kimliği."
    },
    "call_id": {
      "type": "string",
      "description": "Kaydın ait olduğu çağrının kimliği."
    },
    "audio_path": {
      "type": "string",
      "description": "Ses dosyasının yolu."
    },
    "sample_rate": {
      "type": "integer",
      "description": "Örnekleme frekansı (Hz). Telefon bandı için tipik değer 8000.",
      "examples": [8000]
    },
    "channel": {
      "type": "string",
      "enum": ["mono", "dual"],
      "description": "Ses kanal yapısı. 'dual' ise agent ve caller ayrı kanaldadır."
    },
    "speaker": {
      "type": "string",
      "enum": ["agent", "caller", "unknown"],
      "description": "Bu kaydın ait olduğu konuşmacı taraf."
    },
    "speaker_gender": {
      "type": "string",
      "enum": ["kadın", "erkek", "belirsiz"],
      "description": "Konuşmacının sesten tahmini cinsiyeti."
    },
    "speaker_age_band": {
      "type": "string",
      "enum": ["genç", "orta", "yaşlı", "belirsiz"],
      "description": "Konuşmacının sesten tahmini yaş bandı."
    },
    "turn_index": {
      "type": "integer",
      "description": "Kaydın çağrı içindeki sıra numarası (0'dan başlar)."
    },
    "is_silence_probe": {
      "type": "boolean",
      "description": "Bu kayıt halüsinasyon testi için kullanılan probe setinden mi. True ise transcript alanları boş veya kısmi olabilir.",
      "default": false
    },
    "probe_category": {
      "type": ["string", "null"],
      "enum": ["sessizlik", "arka_plan_gurultu", "kirpilmis_ses", "yarim_kalmis_cumle", null],
      "description": "is_silence_probe true ise probe alt kategorisi; değilse null."
    },
    "subset_tags": {
      "type": "array",
      "description": "Kaydın taşıdığı zorluk kategorileri. Birden fazla etiket aynı anda geçerli olabilir.",
      "items": {
        "type": "string",
        "enum": [
          "temiz",
          "gurultulu",
          "aksanli",
          "hizli_konusma",
          "kod_degistirme",
          "rakam_yogun",
          "kisa_yanit",
          "kesintili_barge_in"
        ]
      }
    },
    "transcript_raw": {
      "type": "string",
      "description": "Birebir söylenen (verbatim) transkript — dolgu ifadeleri ve kekemelik dahil, normalize edilmemiş."
    },
    "transcript_normalized": {
      "type": "string",
      "description": "Normalizasyon kurallarına göre işlenmiş transkript. Rakam/tarih/saat/para kanonik forma çevrilmiştir. Büyük/küçük harf ve noktalama olduğu gibi (okunabilir) tutulur — bunlar WER/CER hesaplanırken skorlama kodu tarafından ayrıca kaldırılır, transkriptin kendisinden silinmez."
    },
    "normalization_ruleset_version": {
      "type": "string",
      "description": "Kullanılan normalizasyon kural dokümanının sürümü.",
      "examples": ["1.0"]
    },
    "normalization_ruleset_hash": {
      "type": "string",
      "description": "Dondurulmuş kural dokümanının git hash'i."
    },
    "expected_entities": {
      "type": "array",
      "description": "Kayıtta geçen, iş açısından önemli varlıklar.",
      "items": {
        "type": "object",
        "required": ["type", "value_normalized", "start_char", "end_char"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["ad_soyad", "TCKN", "IBAN", "siparis_no", "tarih", "saat", "tutar", "telefon", "plaka", "diger"]
          },
          "value_raw": {
            "type": "string",
            "description": "Konuşmacının söylediği ham hali."
          },
          "value_normalized": {
            "type": "string",
            "description": "Normalizasyon kurallarına göre kanonik hali."
          },
          "start_char": {
            "type": "integer",
            "description": "transcript_normalized içindeki başlangıç karakter pozisyonu."
          },
          "end_char": {
            "type": "integer",
            "description": "transcript_normalized içindeki bitiş karakter pozisyonu."
          }
        }
      }
    },
    "pii_redacted": {
      "type": "boolean",
      "description": "Gerçek kişisel veri, geçerli formatta sahte veriyle değiştirildi mi."
    },
    "annotator_1_id": {
      "type": "string",
      "description": "Birinci bağımsız etiketleyicinin kimliği."
    },
    "annotator_1_transcript": {
      "type": "string",
      "description": "Birinci etiketleyicinin, ikinci etiketleyiciyi görmeden ürettiği bağımsız transcript_normalized değeri. Kappa hesabı için gerekli."
    },
    "annotator_2_id": {
      "type": "string",
      "description": "İkinci bağımsız etiketleyicinin kimliği."
    },
    "annotator_2_transcript": {
      "type": "string",
      "description": "İkinci etiketleyicinin, birinciyi görmeden ürettiği bağımsız transcript_normalized değeri. Kappa hesabı için gerekli."
    },
    "disagreement": {
      "type": "boolean",
      "description": "annotator_1_transcript ile annotator_2_transcript farklı mı."
    },
    "disagreement_resolved_by": {
      "type": ["string", "null"],
      "description": "Uyuşmazlık varsa çözen üçüncü kişinin kimliği; yoksa null."
    },
    "notes": {
      "type": "string",
      "description": "Etiketleyicinin serbest metin notu."
    }
  },
  "if": {
    "properties": { "is_silence_probe": { "const": false } }
  },
  "then": {
    "required": ["speaker_gender", "speaker_age_band", "subset_tags", "annotator_1_transcript", "annotator_2_transcript", "disagreement"]
  }
}
